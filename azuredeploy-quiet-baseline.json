{
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "_artifactsLocation": {
            "type": "string",
            "metadata": {
                "description": "The base URI where artifacts required by this template are located. When the template is deployed using the accompanying scripts, a private location in the subscription will be used and this value will be automatically generated."
            },
            "defaultValue": "https://raw.githubusercontent.com/MoodleModeInt/Moodle/5.3dev/"
        },
        "_artifactsLocationSasToken": {
            "type": "securestring",
            "metadata": {
                "description": "The sasToken required to access _artifactsLocation.  When the template is deployed using the accompanying scripts, a sasToken will be automatically generated."
            },
            "defaultValue": ""
        },
        "sshPublicKey": {
            "metadata": {
                "description": "ssh public key"
            },
            "type": "string"
        }
    },
    "resources": [
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2021-01-01",
            "name": "mainTemplate",
            "properties": {
                "mode": "Incremental",
                "parameters": {
                    "_artifactsLocation":           { "value": "[parameters('_artifactsLocation')]" },
                    "_artifactsLocationSasToken":   { "value": "[parameters('_artifactsLocationSasToken')]" },
                    "sshPublicKey":                 { "value": "[parameters('sshPublicKey')]" },
                    "autoscaleVmSku":               { "value": "Standard_D4ds_v5" },
                    "autoscaleVmCountMin":          { "value": 1 },
                    "autoscaleVmCountMax":          { "value": 12 },
                    "OSDiskSizeInGB":               { "value": 128 },
                    "dbServerType":                 { "value": "mysqlflex" },
                    "vnetDbDeploySwitch":           { "value": true },
                    "mysqlflexSkuName":             { "value": "Standard_D2ds_v4" },
                    "mysqlflexStgSizeGiB":          { "value": 128 },
                    "mysqlflexStgIops":             { "value": 1000 },
                    "mysqlflexStgAutogrow":         { "value": "Enabled" },
                    "redisDeploySwitch":            { "value": true },
                    "redisSkuName":                 { "value": "Balanced_B3" },
                    "redisHighAvailability":        { "value": "Disabled" },
                    "fileServerType":               { "value": "azurefiles" },
                    "fileServerDiskSize":           { "value": 256 },
                    "storageAccountType":           { "value": "Premium_LRS" }
                },
                "templateLink": {
                    "uri": "[concat(parameters('_artifactsLocation'), 'azuredeploy.json', if(startsWith(parameters('_artifactsLocationSasToken'), '?'), parameters('_artifactsLocationSasToken'), ''))]"
                }
            }
        }
    ],
    "outputs": {
        "mainTemplateOutputs": {
            "type": "object",
            "value": "[reference('mainTemplate').outputs]"
        }
    },
    "variables": {
        "documentation01": "Quiet-baseline wrapper for the migration test: small always-on footprint sized for long idle periods, with online scale-up paths for mandatory-course events.",
        "documentation02": "Web tier autoscales 1-12 x Standard_D4ds_v5; MySQL Flexible D2ds_v4 128GiB/1000 IOPS with storage autogrow; Azure Files Premium 256GiB share (grow quota online for events); Azure Managed Redis Balanced_B3 non-HA.",
        "documentation03": "searchType is intentionally not set (defaults to none) - no search VMs are deployed.",
        "documentation04": "Only required parameter is sshPublicKey."
    }
}
